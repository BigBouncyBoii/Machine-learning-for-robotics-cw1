%% Every number is a validation accuracy (leave-one-person-out on the 120 train clips).
%% Initials: JL = James L, JF = James F, QL = Qian L, JE = Jeevan.

%%{init: {"flowchart": {"wrappingWidth": 500, "curve": "basis"}}}%%
flowchart LR
    Q["<b>Can video tell a light grip<br/>from a firm grip?</b>"]

    %% James L: frozen DINOv2
    D1["DINOv2 frozen + LR, 16 frames (JL)<br/>val 62.5% → baseline"]
    D2["VideoMAE (JL)<br/>val 65.8% LR, 57.8% MLP → dropped"]
    D3["MLP (JL)<br/>val 63.8% → kept"]
    D4["5-MLP ensemble (JL)<br/>val 64.2% → kept, stable"]
    D5["Start, frames 0–2 (JL)<br/>val 49.2% → control, dropped"]
    D6["Middle, frames 5–10 (JL)<br/>val 75.0% → kept"]
    D7["Middle 1/2/4/6/8/10 frames (JL)<br/>val 69.2/72.5/72.5/75.0/71.7/71.7% → 6 CHOSEN"]

    %% James F: finger colour
    F1["Rest vs hold colour (JF)<br/>val 60.0% → refined"]
    F2["Per-finger colour curves (JF)<br/>val 70.0% → kept"]
    F3["10-MLP ensemble (JF)<br/>val 65.8% → no better than LR"]

    %% Qian L: optical flow
    M1["Closing speed (QL)<br/>val 55.0% → dropped"]
    M2["Shaking (QL)<br/>val 60.8% → best motion cue"]
    M3["Speed + shaking (QL)<br/>val 60.0% → no gain"]

    %% Jeevan: joint angles
    J1["Joint angles, MediaPipe (JE)<br/>val 59.2% → dropped"]

    T["<b>Final method, test set</b><br/>38/40 = 95.0% (guessing 50%)"]

    Q --> D1
    D1 --> D2
    D1 --> D3
    D3 --> D4
    D4 --> D5
    D4 --> D6
    D6 --> D7
    D7 ==> T

    Q --> F1
    F1 --> F2
    F2 --> F3

    Q --> M1
    Q --> M2
    M2 --> M3

    Q --> J1

    classDef root fill:#ffffff,stroke:#333,stroke-width:2px;
    classDef chosen fill:#c8e6c9,stroke:#2e7d32,stroke-width:3px;
    classDef kept fill:#e3f2fd,stroke:#1565c0;
    classDef dropped fill:#f5f5f5,stroke:#9e9e9e,color:#555;
    classDef control fill:#fff8e1,stroke:#f9a825;
    classDef final fill:#2e7d32,stroke:#1b5e20,color:#fff;

    class Q root;
    class D7 chosen;
    class D1,D3,D4,D6,F1,F2,M2 kept;
    class D2,F3,M1,M3,J1 dropped;
    class D5 control;
    class T final;
